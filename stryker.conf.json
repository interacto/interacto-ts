{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "typescriptChecker": {
    "prioritizePerformanceOverAccuracy": true
  },
  "vitest": {
    "configFile": "./vitest.config.ts"
  },
  "packageManager": "npm",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "perTest",
  "mutator": { "plugins": ["classProperties"],
    "excludedMutations": ["ArithmeticOperator", "ArrayDeclaration", "AssignmentExpression",
      "BooleanLiteral", "CheckedStatement", "ConditionalExpression", "EqualityOperator",
      "LogicalOperator", "MethodExpression", "StringLiteral", "UnaryOperator", "UpdateOperator"] }
}
